# ===============================
# Public app config
# ===============================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===============================
# Next.js Server Actions (fix "Failed to find Server Action" on deploy)
# ===============================
# Bắt buộc khi self-host với PM2/cluster. Tạo key: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-32-byte-key
NEXT_PUBLIC_APP_URL=https://nanoai.vn
APP_URL=https://nanoai.vn
# URL nội bộ cho fetch server-to-server (tránh lỗi SSL khi đứng sau proxy)
# Ví dụ: APP_INTERNAL_URL=http://127.0.0.1:3000

# ===============================
# Supabase
# ===============================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===============================
# Auth bypass (dev only)
# ===============================
# AUTH_BYPASS_LOCAL=true
# AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# ===============================
# Google AI / Vision
# ===============================
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
# Giáo trình giáo dục – kiến thức quan trọng không được sai:
# - Tạo giáo trình, phiếu bài tập, phân tích slide: Gemini 2.5 Pro
# - Tạo câu trắc nghiệm: Gemini Pro → DeepSeek verify → nếu sai GPT tạo lại → DeepSeek verify
# Kiểm tra chéo quiz: mặc định bật. Set =false để tắt.
# SLIDE_QUIZ_VERIFY=true
# Model GPT retry khi DeepSeek báo quiz sai (dùng OPENAI_API_KEY). Mặc định gpt-4o-mini.
# EDUCATIONAL_RETRY_MODEL=gpt-4o-mini
# Báo cáo câu hỏi sai (lần 2): model GPT kiểm tra. Mặc định gpt-4o. Có thể set gpt-5 khi có.
# QUIZ_REPORT_GPT_MODEL=gpt-4o
# Pexels API – tìm ảnh minh họa cho slide (MIỄN PHÍ: pexels.com/api)
# 200 requests/giờ, 20.000/tháng. Có thể xin unlimited miễn phí nếu ghi rõ nguồn.
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# Optional. Default: deepseek-chat. Set deepseek-reasoner cho chính xác hơn (output tối đa 64K).
# DEEPSEEK_MODEL=deepseek-reasoner
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional. Model cho GPT 5 (tạo giáo trình). Default: gpt-5
# OPENAI_MODEL=gpt-5
# Optional. Default: gpt-5-mini
# OPENAI_FALLBACK_MODEL=gpt-5-mini
# Tạo slide giáo trình: dùng OpenAI thay Gemini. Set =true hoặc set SLIDE_OPENAI_MODEL.
# SLIDE_USE_OPENAI=true
# Model OpenAI cho tạo slide. Mặc định: OPENAI_FALLBACK_MODEL hoặc gpt-5-mini.
# SLIDE_OPENAI_MODEL=gpt-5-mini
GOOGLE_AI_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_AI_LOCATION=us-central1
GOOGLE_CLOUD_VISION_API_KEY=YOUR_VISION_API_KEY
VISION_CREDENTIALS_PATH=./gcp-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
# Lưu ý: Google Cloud Text-to-Speech fallback cũng dùng cùng service account credentials này.

# ===============================
# API security
# ===============================
PROCESS_TRANSLATE_SECRET=your-random-secret-at-least-32-chars

# ===============================
# SePay
# ===============================
SEPAY_MERCHANT_ID=SP-LIVE-XXXXXXXX
SEPAY_SECRET_KEY=spsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEPAY_API_URL=https://api.sepay.vn
SEPAY_REQUIRE_SIGNATURE=true
NEXT_PUBLIC_SEPAY_CONTENT_PREFIX=DH
NEXT_PUBLIC_SEPAY_CONTENT_SUFFIX_MIN_LENGTH=1
NEXT_PUBLIC_SEPAY_CONTENT_SUFFIX_MAX_LENGTH=10

# ===============================
# Optional feature icons (Supabase Storage signed/public URL)
# ===============================
# NEXT_PUBLIC_TRY_ON_ICON_URL=
# NEXT_PUBLIC_IMAGE_RESTORATION_ICON_URL=
# NEXT_PUBLIC_LAM_NET_ANH_ICON_URL=

# ===============================
# Hugging Face (dataset gated: Viet-Doc-VQA...)
# ===============================
# Token có quyền read – dùng khi import dataset gated. Tạo tại: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_xxxx

# ===============================
# Sticker / rembg (default: disabled)
# ===============================
STICKER_STRIP_BACKGROUND=false
STICKER_USE_REMBG=false
# REMBG_PYTHON=python