# Hướng dẫn điền .env.local (local + VPS), checklist cron/Vision, quy tắc cho AI:
# docs/ENV_LOCAL_REFERENCE.md — biến mới trong code: cập nhật .env.example + .env.local;
# Loại bỏ hoàn toàn Supabase (env alias, CLI, quy tắc PR): docs/huong-dan-loai-bo-supabase.md
# mật khẩu/key user đưa trong chat: dùng cho .env.local, không cần cảnh báo dài trong hội thoại.
#
# ===============================
# Public app config
# ===============================
# Local: http://localhost:3000. Production: https://nanoai.vn (bắt buộc cho robots.txt, sitemap, OG)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ===============================
# Next.js Server Actions (fix "Failed to find Server Action" on deploy)
# ===============================
# Bắt buộc khi self-host với PM2/cluster. Tạo key: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=your-base64-32-byte-key
NEXT_PUBLIC_APP_URL=https://nanoai.vn
APP_URL=https://nanoai.vn
# Widget chat nổi (layout): nếu trống trong admin DB, dùng slug hoặc mã iframe đầy đủ. Slug phải khớp partner messaging đang active (nếu không → 404 trong iframe).
# NEXT_PUBLIC_CHAT_WIDGET_SLUG=your-messaging-partner-slug
# NEXT_PUBLIC_CHAT_WIDGET_EMBED=<iframe src="https://..." title="Chat" loading="lazy"></iframe>
# URL nội bộ cho fetch server-to-server (tránh lỗi SSL khi đứng sau proxy)
# Ví dụ: APP_INTERNAL_URL=http://127.0.0.1:3000

# ===============================
# Postgres trực tiếp — BẮT BUỘC cho credits (không qua HTTP REST công khai cho bảng credits)
# ===============================
# Connection string: postgresql://USER:PASS@HOST:5432/DB?sslmode=require
# Lấy URI: bảng điều khiển host DB → connection string (hoặc VPS sau khi restore).
# Kiểm tra schema: npm run pg:check-credits  (cần public.credits + public.spend_credits_idempotent)
# DATABASE_URL=postgresql://USER:PASSWORD@your-db-host.example:5432/your_database?sslmode=require
# (tuỳ chọn) URL Postgres 17 local — dùng cho npm run pg:fresh-restore-public nếu muốn tránh lỗi transaction_timeout
# DATABASE_URL_PG17=
# PG_FRESH_DB_NAME=thudo_restored
# PG_RESTORE_SQL_PIPELINE=0  — tắt lọc SQL (bỏ SET transaction_timeout) khi restore; mặc định bật trên PG<17
# pg_dump / backup: ưu tiên PG_DUMP_SOURCE_URL; tiếp DATABASE_BACKUP_SOURCE_URL, LEGACY_PG_DUMP_URI; thêm mục «Tên env cũ» ở cuối file.
# PG_DUMP_SOURCE_URL=
# DATABASE_BACKUP_SOURCE_URL=
# LEGACY_PG_DUMP_URI=
# PG_BIN=C:\Program Files\PostgreSQL\15\bin
# PG_POOL_MAX=10
# RLS/policy cần role authenticated + auth.uid(): sau restore Postgres tự host có thể chạy npm run pg:ensure-auth-compat (scripts/pg-ensure-auth-compat.mjs).
#
# Cờ tùy chọn (audit): src/lib/direct-pg-env-flags.ts — server: DIRECT_PG_FLAG, USE_DIRECT_PG, PG_DIRECT_STACK; client: NEXT_PUBLIC_DIRECT_PG_FLAG, NEXT_PUBLIC_USE_DIRECT_PG, NEXT_PUBLIC_PG_DIRECT_STACK (=1 hoặc true). Kế thừa: ZERO_*, NEXT_PUBLIC_ZERO_* (xem mục Deprecated).
#
# Đăng nhập email tự host (OTP + magic link). Cần: DATABASE_URL, SMTP_*, migration `db/migrations/20260408120000_email_auth_challenges.sql`, bảng auth.users + auth.instances (schema Auth kiểu hosted cũ).
# AUTH_JWT_SECRET — tối thiểu 32 ký tự: openssl rand -base64 32
# EMAIL_AUTH_ENABLED=false
# AUTH_JWT_SECRET=
# Phiên chỉ cookie JWT email — middleware không gọi hosted Auth; ẩn Google OAuth. Chỉ bật khi user chỉ đăng nhập OTP/link.
# AUTH_EMAIL_SESSION_ONLY=false
# OTP + link magic cùng thời hạn (phút), mặc định 15.
# EMAIL_MAGIC_LINK_TTL_MINUTES=15
# Chống spam: chờ giữa hai lần gửi cùng email (giây), tối đa 600. Mặc định 90.
# OTP_RESEND_COOLDOWN_SECONDS=90
# Tối đa số lần gửi / email / giờ (mặc định 5).
# OTP_MAX_PER_EMAIL_PER_HOUR=5
# Tối đa số lần gửi / IP / giờ (mặc định 40; 0 = tắt giới hạn IP).
# OTP_MAX_PER_IP_PER_HOUR=40
# Cookie + JWT đăng nhập (ngày), mặc định 400, tối đa 3650 (~10 năm).
# EMAIL_SESSION_MAX_AGE_DAYS=400

# ===============================
# Bunny Storage (HTTP API — bắt buộc cho ảnh/video/audio public: try-on, bài thi tự luận, ghi âm cuộc họp)
# ===============================
# Media mới lên Bunny Storage; thiếu 3 biến dưới → upload media sẽ lỗi.
# App dùng PUT tới https://storage.bunnycdn.com (không dùng FTP/FileZilla trong code).
# Username FTP = tên storage zone. Password FTP = API Access Key (trên dashboard).
# BUNNY_STORAGE_ZONE=your-storage-zone-name
# BUNNY_STORAGE_API_KEY=your-storage-zone-password
# Pull zone / CDN base, không có dấu / cuối — ví dụ: https://yourzone.b-cdn.net hoặc custom hostname
# next/image: build cần biến này để remotePatterns cho ảnh Bunny (cùng host với URL public upload).
# BUNNY_STORAGE_PUBLIC_BASE_URL=https://yourzone.b-cdn.net

# ===============================
# Storage REST legacy — `/storage/v1/object/...` (chỉ khi còn URL/file cũ hoặc script backfill)
# ===============================
# Khuyến nghị: NEXT_PUBLIC_STORAGE_LEGACY_REST_ORIGIN + STORAGE_LEGACY_SERVICE_KEY.
# Nếu chưa đổi .env: fallback đọc cặp URL public + service key legacy bên dưới.
# next/image (remotePatterns): build cần NEXT_PUBLIC_STORAGE_LEGACY_REST_ORIGIN hoặc URL public legacy (mục «Auth / URL public»).
# NEXT_PUBLIC_STORAGE_LEGACY_REST_ORIGIN=https://YOUR_REST_HOST
# STORAGE_LEGACY_SERVICE_KEY=YOUR_SERVICE_ROLE_OR_STORAGE_KEY
# (chỉ server, không cần NEXT_PUBLIC) STORAGE_LEGACY_REST_ORIGIN=https://YOUR_REST_HOST
#
# ===============================
# Origin HTTP công khai + khóa service (session hosted cũ / Storage REST fallback)
# ===============================
# Không dùng SDK npm hosted client; ưu tiên tên trung tính (code đọc các biến này trước, rồi alias cũ).
NEXT_PUBLIC_LEGACY_HTTP_ORIGIN=https://YOUR_AUTH_OR_STORAGE_HTTP_ORIGIN
LEGACY_HTTP_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET
# --- Alias cũ (vẫn đọc trong code; có thể bỏ khi đã đổi hết sang tên trên; checklist: docs/huong-dan-loai-bo-supabase.md) ---
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Giới hạn thời gian chờ middleware (getUser) + layout (integrations). Tránh trang xoay vô hạn khi API treo (ms). Mặc định 8000.
# APP_HTTP_REQUEST_TIMEOUT_MS=8000
# Bắt buộc cho ký JWT thứ tự đáp án trắc nghiệm khi HS mở đề (openssl rand -base64 32)
# EXAM_LAYOUT_SECRET=

# ===============================
# Auth bypass (dev only)
# ===============================
# AUTH_BYPASS_LOCAL=true
# AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000000
# NEXT_PUBLIC_AUTH_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# ===============================
# Google AI / Vision
# ===============================
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
# Giáo trình giáo dục – kiến thức quan trọng không được sai:
# - Tạo giáo trình, phiếu bài tập, phân tích slide: Gemini 2.5 Pro
# - Tạo câu trắc nghiệm: Gemini Pro → DeepSeek verify → nếu sai GPT tạo lại → DeepSeek verify
# Kiểm tra chéo quiz: mặc định bật. Set =false để tắt.
# SLIDE_QUIZ_VERIFY=true
# Model GPT tạo lại câu hỏi khi Gemini/parse lỗi. Dùng gpt-4o hoặc gpt-5 (KHÔNG dùng mini).
# EDUCATIONAL_RETRY_MODEL=gpt-4o
# Báo cáo câu hỏi sai (lần 2): model GPT kiểm tra. Mặc định gpt-4o. Có thể set gpt-5 khi có.
# QUIZ_REPORT_GPT_MODEL=gpt-4o
# Pexels API – tìm ảnh minh họa cho slide (MIỄN PHÍ: pexels.com/api)
# 200 requests/giờ, 20.000/tháng. Có thể xin unlimited miễn phí nếu ghi rõ nguồn.
PEXELS_API_KEY=YOUR_PEXELS_API_KEY
# Bắt buộc cho: kiểm tra sửa giáo trình (2 AI), quiz verify, English coach, tạo đề trắc nghiệm
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
# Optional. Kiểm tra sửa giáo trình + verify quiz: mặc định deepseek-reasoner
# DEEPSEEK_VERIFY_MODEL=deepseek-reasoner
# Optional. Tạo đề trắc nghiệm, English coach: mặc định deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional. Model cho GPT 5 (tạo giáo trình). Default: gpt-5
# OPENAI_MODEL=gpt-5
# Optional. Default: gpt-5-mini
# OPENAI_FALLBACK_MODEL=gpt-5-mini
# Tạo slide giáo trình: dùng OpenAI thay Gemini. Set =true hoặc set SLIDE_OPENAI_MODEL.
# SLIDE_USE_OPENAI=true
# Model OpenAI cho tạo slide. Mặc định: OPENAI_FALLBACK_MODEL hoặc gpt-5-mini.
# SLIDE_OPENAI_MODEL=gpt-5-mini
GOOGLE_AI_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
GOOGLE_AI_LOCATION=us-central1
GOOGLE_CLOUD_VISION_API_KEY=YOUR_VISION_API_KEY
VISION_CREDENTIALS_PATH=./gcp-credentials.json
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
# Messaging: Vertex AI Vision Image Warehouse — GCS bucket for catalog images + JSONL import (service account: Vision AI + Storage on bucket & project)
# GCS_VISION_CATALOG_BUCKET=your-vision-catalog-bucket
# App không đọc biến «region của bucket» trong env — chỉ cần tên bucket; vùng thực tế xem GCP Console (bucket / corpus / endpoint có thể khác region).
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
# Số dự án (Warehouse REST bắt buộc trong URL). Có thể bỏ trống nếu server gọi được Cloud Resource Manager.
# GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
# Corpus / index / endpoint — phải là Image Warehouse loại ảnh (IMAGE). Corpus video/loại khác → lỗi CORPUS_UNSUPPORTED_TYPE khi import.
# Xem: https://cloud.google.com/vision-ai/docs/image-warehouse-creation
# ID index/endpoint có thể là dạng số hoặc tiền tố Console (ví dụ image-index-…, ie-…).
# Ví dụ: sau khi tạo corpus + Visual Search index + index endpoint và Deploy index → Active
# VISION_WAREHOUSE_CORPUS_ID=3696913078352383326
# VISION_WAREHOUSE_INDEX_ID=image-index-605095482433149475
# VISION_WAREHOUSE_INDEX_ENDPOINT_ID=ie-13318115606637438122
# Windows: VISION_CREDENTIALS_PATH có thể là đường dẫn tuyệt đối (G:\...\key.json) nếu chạy app từ thư mục khác.
# Vùng analyze/reindex: lưu trong DB vision_warehouse_runner.warehouse_location khi đồng bộ catalog (không đọc biến env).
# VISION_WAREHOUSE_LOCATION=us-central1
# Sau đồng bộ catalog, app gọi kick analyze một lần (không poll lâu); vẫn cần cron định kỳ để poll op + PATCH index.
# Cron: analyze corpus + rebuild index sau import (migration vision_warehouse_runner). Có thể dùng chung VISION_CATALOG_SYNC_CRON_SECRET
# VISION_WAREHOUSE_REINDEX_CRON_SECRET=your-random-secret
# GET/POST /api/cron/vision-warehouse-reindex  Authorization: Bearer <secret>
#
# Fallback tim anh khong dung Vision Warehouse: Gemini embedding image
# Model khuyen nghi: gemini-embedding-2-preview
# GEMINI_IMAGE_EMBED_MODEL=gemini-embedding-2-preview
# So chieu embedding (128..3072). 768 la can bang chat luong/chi phi/latency.
# GEMINI_IMAGE_EMBED_DIMS=768
# So san pham quet moi request image-search (anh huong toc do + do chinh xac)
# GEMINI_IMAGE_SEARCH_SCAN_LIMIT=400
# So luong tai embedding song song moi request
# GEMINI_IMAGE_SEARCH_PARALLEL=4
# Cache embedding URL anh trong memory (ms)
# GEMINI_IMAGE_EMBED_CACHE_TTL_MS=86400000
#
# Tuỳ chọn — nếu lỗi timeout Vision operation (assets:import): giảm batch hoặc tăng poll (VPS).
# VISION_INCREMENTAL_BATCH_SIZE=10
# (Mặc định app 10) Ưu tiên ổn định khi catalog lớn/ảnh host chậm; nếu hạ tầng tốt có thể tăng 15–20.
# Google chỉ cho 1 ImportAssets đồng thời / corpus — mặc định app 1 lần import mỗi lượt sync (tránh 429).
# VISION_INCREMENTAL_MAX_IMPORTS_PER_REQUEST=1
# Nghỉ sau mỗi lô import thành công (ms), giúp giải phóng slot trên Google.
# VISION_WAREHOUSE_POST_IMPORT_COOLDOWN_MS=5000
# VISION_WAREHOUSE_ASSETS_IMPORT_POLL_MAX_MS=900000
# (Mặc định app 900000 ms = 15 phút) Catalog lớn trên VPS có thể tăng (vd. 1800000); route cron / vision-catalog-sync maxDuration phải ≥ poll + vài phút tải ảnh (app đặt 1200s).
#
# Lưu ý: Google Cloud Text-to-Speech fallback cũng dùng cùng service account credentials này.

# ===============================
# SMTP – thông báo tài khoản (thongbao@nanoai.vn)
# ===============================
# Khi đủ biến, server gửi email kèm các thông báo đã ghi vào bảng notifications (vd: xử lý báo cáo câu hỏi).
# P.A / maychuemail: thường SMTPS port 465 (SMTP_SECURE=true) hoặc 587 STARTTLS (SMTP_SECURE=false).
# SMTP_HOST=mail9005.maychuemail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=thongbao@nanoai.vn
# SMTP_PASS=your-mailbox-password
# SMTP_FROM="NanoAI <thongbao@nanoai.vn>"
# Khi cấu hình: email + thông báo chuông — nạp credit (SePay), thưởng giới thiệu (người mời + người được mời), xử lý báo cáo câu hỏi sai.

# ===============================
# Web Push (PWA Android / Chrome) — cần chạy migration push_subscriptions
# Tạo cặp key: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=BP...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:thongbao@nanoai.vn

# ===============================
# API security
# ===============================
PROCESS_TRANSLATE_SECRET=your-random-secret-at-least-32-chars

# Cron / tự động: verify hàng loạt phiếu bài tập (câu chưa có verified_at)
# Gọi: GET /api/cron/worksheet-verify-batch?batchSize=2
# Header: Authorization: Bearer <secret>
# ADMIN_WORKSHEET_VERIFY_CRON_SECRET=your-random-secret-at-least-32-chars

# Cron: xóa ảnh bài thi tự luận quá hạn trên storage (bucket exam-essay-images)
# GET hoặc POST /api/cron/exam-essay-images-cleanup
# Header: Authorization: Bearer <secret>
# EXAM_ESSAY_IMAGES_CRON_SECRET=your-random-secret-at-least-32-chars

# Cron: xóa bản ghi cuộc họp quá 7 ngày (DB meeting_recordings + bucket meeting-recordings)
# GET hoặc POST /api/cron/meeting-recordings-cleanup
# Header: Authorization: Bearer <secret>
# MEETING_RECORDINGS_CRON_SECRET=your-random-secret-at-least-32-chars

# Cron: nhắc ôn từ vựng (SRS) — Học ngoại ngữ AI
# GET /api/cron/coach-review-reminder
# Header: Authorization: Bearer <secret>
# COACH_REVIEW_REMINDER_CRON_SECRET=your-random-secret-at-least-32-chars

# ===============================
# SePay
# ===============================
SEPAY_MERCHANT_ID=SP-LIVE-XXXXXXXX
SEPAY_SECRET_KEY=spsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEPAY_API_URL=https://api.sepay.vn
SEPAY_REQUIRE_SIGNATURE=true
NEXT_PUBLIC_SEPAY_CONTENT_PREFIX=DH
NEXT_PUBLIC_SEPAY_CONTENT_SUFFIX_MIN_LENGTH=1
NEXT_PUBLIC_SEPAY_CONTENT_SUFFIX_MAX_LENGTH=10

# ===============================
# Optional feature icons (URL ký/công khai trên storage cũ nếu còn dùng)
# ===============================
# NEXT_PUBLIC_TRY_ON_ICON_URL=
# NEXT_PUBLIC_IMAGE_RESTORATION_ICON_URL=
# NEXT_PUBLIC_LAM_NET_ANH_ICON_URL=

# ===============================
# Hugging Face (dataset gated: Viet-Doc-VQA...)
# ===============================
# Token có quyền read – dùng khi import dataset gated. Tạo tại: https://huggingface.co/settings/tokens
# HUGGINGFACE_TOKEN=hf_xxxx

# ===============================
# Chăm sóc khách hàng — Facebook Messenger & Zalo OA (tuỳ chọn)
# ===============================
# Webhook Facebook: GET/POST https://YOUR_DOMAIN/api/integrations/facebook/messenger/webhook
# FACEBOOK_MESSENGER_VERIFY_TOKEN=        # hub.verify_token khi Meta gọi GET
# FACEBOOK_MESSENGER_PAGE_ACCESS_TOKEN=   # Gửi tin qua Graph API
# FACEBOOK_MESSENGER_APP_SECRET=         # Bắt buộc production: xác minh X-Hub-Signature-256
#
# Webhook Zalo OA: POST https://YOUR_DOMAIN/api/integrations/zalo/oa/webhook
# ZALO_OA_WEBHOOK_SECRET=               # Khớp header bảo mật (vd. X-Bot-Api-Secret-Token) theo cấu hình Zalo
# ZALO_OA_ACCESS_TOKEN=                 # Gửi tin qua openapi.zalo.me
#
# Đối tác (B2B) inbox: cùng URL webhook; Meta gửi Page ID, Zalo gửi secret theo từng OA — app route map vào workspace.
# Chat nhúng: NEXT_PUBLIC_BASE_URL (hoặc NEXT_PUBLIC_APP_URL) để hiển thị URL /api/messaging/embed/{slug}; header X-Embed-Key + X-Session-Id.
# Ảnh khách (embed): POST multipart /api/messaging/embed/{slug}/image — headers X-Embed-Key, X-Session-Id; field file. Sau đó POST JSON /api/messaging/embed/{slug} với { text?, imageStoragePath }.
# Ảnh khách (trang hosted /messaging/p/...): POST multipart /api/messaging/guest/{slug}/image (field sessionId, file) rồi POST JSON /api/messaging/guest/{slug} như trên. Lưu bucket try-on-images (public URL) đã có trong dự án.
# Tìm sản phẩm bằng ảnh (web shop, Bearer từ dashboard): POST multipart /api/messaging/partners/{partnerId}/image-search — field image hoặc file; optional limit. CORS *.
# Giới hạn tần suất theo IP+shop (một process / instance). Mặc định 60 request / 60 giây → 429 + Retry-After.
# IMAGE_SEARCH_RATE_LIMIT_MAX=60
# IMAGE_SEARCH_RATE_LIMIT_WINDOW_MS=60000
# Open Catalog (POST JSON kho /api/messaging/partners/{partnerId}/inventory/open-sync): giới hạn IP+shop; mặc định dùng IMAGE_SEARCH_RATE_LIMIT_* nếu không set.
# PARTNER_INVENTORY_OPEN_SYNC_RATE_LIMIT_MAX=30
# PARTNER_INVENTORY_OPEN_SYNC_RATE_LIMIT_WINDOW_MS=60000
# Open Catalog payload lớn: backend có thể gửi danh sách lớn, server tự xử lý 1 request.
# PARTNER_INVENTORY_OPEN_SYNC_MAX_BODY_BYTES=35000000
# PARTNER_INVENTORY_OPEN_SYNC_MAX_ITEMS=100000
# Import Excel kho từ dashboard (multipart): giới hạn số dòng parse mỗi lần import.
# PARTNER_INVENTORY_IMPORT_MAX_ROWS=100000
# Dashboard kho hàng: số dòng tải ban đầu / mỗi lần "Tải thêm".
# PARTNER_INVENTORY_UI_PAGE_SIZE=120
# Guest chat email auth (magic link + OTP) — rate limit theo partner + IP + email.
# GUEST_AUTH_EMAIL_REQUEST_RATE_LIMIT_MAX=10
# GUEST_AUTH_EMAIL_REQUEST_RATE_LIMIT_WINDOW_MS=600000
# GUEST_AUTH_EMAIL_VERIFY_RATE_LIMIT_MAX=20
# GUEST_AUTH_EMAIL_VERIFY_RATE_LIMIT_WINDOW_MS=600000
# Khách chat trên domain NanoAI (không cần nhúng): /messaging/p/{slug} — cùng kênh widget trong inbox đối tác.
#
# Cron: trợ lý AI inbox đối tác (FAQ + trả lời trễ bằng DeepSeek khi không có người trả lời)
# GET hoặc POST /api/cron/messaging-partner-ai — gợi ý mỗi phút
# Header: Authorization: Bearer <secret>
# Cần DEEPSEEK_API_KEY (và tuỳ chọn DEEPSEEK_MODEL) trên server.
# MESSAGING_PARTNER_AI_CRON_SECRET=your-random-secret-at-least-32-chars
# Cron: tự động backfill embedding ảnh kho sản phẩm (chạy ngầm, không cần mở dashboard).
# GET hoặc POST /api/cron/messaging-inventory-embed-backfill
# Header: Authorization: Bearer <MESSAGING_INVENTORY_EMBED_CRON_SECRET>
#         (hoặc MESSAGING_PARTNER_AI_CRON_SECRET nếu không set embed secret;
#          hoặc CRON_SECRET — Vercel Cron tự gửi Bearer này khi bạn set CRON_SECRET trùng một trong các secret trên).
# MESSAGING_INVENTORY_EMBED_CRON_SECRET=your-random-secret-at-least-32-chars
# MESSAGING_INVENTORY_EMBED_CRON_PARTNERS_PER_RUN=8
# MESSAGING_INVENTORY_EMBED_CRON_SCAN_ROWS=5000
# MESSAGING_INVENTORY_EMBED_CRON_LIMIT_PER_PARTNER=800
# ——— Vercel: thêm file vercel.json (đã có trong repo) với crons mỗi 5 phút.
#     Trên Vercel Dashboard → Settings → Environment Variables: đặt CRON_SECRET cùng giá trị
#     với MESSAGING_INVENTORY_EMBED_CRON_SECRET (hoặc chỉ dùng một secret và thêm vào cả hai biến).
# ——— VPS / crontab: dùng curl như ví dụ dưới (tăng -m nếu batch lớn).
# Gemini embedding worker:
# GEMINI_IMAGE_EMBED_SYNC_LIMIT=1200
# GEMINI_IMAGE_EMBED_SCAN_PAGE_SIZE=1000
# GEMINI_IMAGE_EMBED_SCAN_MAX_ROWS=30000
# Ví dụ crontab:
# */5 * * * * curl -fsS -m 600 -X POST "https://YOUR_DOMAIN/api/cron/messaging-inventory-embed-backfill" -H "Authorization: Bearer YOUR_SECRET" >> /root/logs/inventory-embed-backfill.log 2>&1
# Vision nền (Google) — thường dùng **hai** crontab cùng Bearer VISION_CATALOG_SYNC_CRON_SECRET:
# (1) Mỗi 3 phút: xử lý job đã xếp hàng — GET/POST /api/cron/vision-catalog-sync
# (2) Mỗi ngày 1 lần: xếp hàng lại cho mọi shop bật gợi ý ảnh — GET/POST /api/cron/vision-bg-sync-enqueue
# VISION_CATALOG_SYNC_CRON_SECRET=your-random-secret-at-least-32-chars
# Tuỳ chọn — secret riêng cho enqueue (không set = dùng chung secret catalog)
# VISION_BG_SYNC_ENQUEUE_CRON_SECRET=your-random-secret-at-least-32-chars
# Ví dụ cặp crontab (đổi DOMAIN + YOUR_SECRET; giờ 03:15 có thể đổi):
# */3 * * * * curl -fsS -m 600 -X POST "https://YOUR_DOMAIN/api/cron/vision-catalog-sync" -H "Authorization: Bearer YOUR_SECRET" >> /root/logs/vision-catalog.log 2>&1
# 15 3 * * * curl -fsS -m 120 -X POST "https://YOUR_DOMAIN/api/cron/vision-bg-sync-enqueue" -H "Authorization: Bearer YOUR_SECRET" >> /root/logs/vision-bg-enqueue.log 2>&1
# Không có cron → job vẫn tạo nhưng AI không gửi (trừ khi bật wake bên dưới). `next dev` tự chạy batch sau thời gian chờ.
# `next start` local / staging chưa có cron:
# MESSAGING_PARTNER_AI_DEV_WAKE=1
# VPS một node production chưa có cron (không dùng khi nhiều replica/serverless):
# MESSAGING_PARTNER_AI_INLINE_WAKE=1

# ===============================
# Partner API – thử đồ ảo (B2B, tích hợp web khách)
# ===============================
# Không cần env mới: dùng LEGACY_HTTP_SERVICE_ROLE_KEY (hoặc alias trong mục trên) + GOOGLE_API_KEY như thử đồ nội bộ.
# Tạo client: bảng partner_try_on_clients (migration db/migrations); key_hash = SHA-256(secret UTF-8);
# billing_user_id = user có credits trong DB. Gọi từ backend khách: POST /api/v1/partner/try-on, Authorization: Bearer <secret>.

# ===============================
# Sticker / rembg (default: disabled)
# ===============================
STICKER_STRIP_BACKGROUND=false
STICKER_USE_REMBG=false
# REMBG_PYTHON=python

# ===============================
# Tên env cũ (vẫn có thể đọc trong code — xoá khi đã đổi hết .env)
# ===============================
# SUPABASE_DB_URL=