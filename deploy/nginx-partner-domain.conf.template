# Template vhost HTTPS cho tên miền shop — deploy/provision-partner-domain-ssl.sh thay __HOSTNAME__
# Cần /etc/nginx/conf.d/nanoai.conf + /etc/nginx/snippets/nanoai-shop-locations.inc
server {
    listen 80;
    listen [::]:80;
    server_name __HOSTNAME__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOSTNAME__;

    ssl_certificate /etc/letsencrypt/live/__HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOSTNAME__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/nanoai-shop-locations.inc;
}
