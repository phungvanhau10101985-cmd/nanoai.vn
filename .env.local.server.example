# Copy thành .env.local.server và điền giá trị thật (file .env.local.server đã gitignore).
# Windows: copy .env.local.server.example .env.local.server

VPS_HOST=YOUR_VPS_IP
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD="YOUR_SSH_PASSWORD"

VPS_APP_DIR=/var/www/Thu-do-online
VPS_188_DIR=/var/www/188.com.vn
VPS_SSH_ALIAS=nanoai-vps
